# Maintainer-local notes (workspaces, plans, consumer list, catalog
# maintenance skills). _local/ is its own git repository with a private remote.
_local/

# Issue tracker (markdown issues per feature) until the repo is opened and
# issues move to GitHub Issues.
.scratch/

# Dependencies
node_modules/

# Local skill and agent links for sessions in this repo (scripts/link-skills.mjs).
# Never commit them: the skills CLI installs every skill it finds under a source
# repo's .claude/skills/, whatever the manifest lists (docs/adr/0001).
.claude/skills/
.claude/agents/

# Third-party skills a maintainer installs into this repo with the skills CLI (the
# mattpocock/skills suite from the README). Never commit them or their lock file:
# this repo does not list or vendor them (docs/adr/0001).
.agents/
skills-lock.json
