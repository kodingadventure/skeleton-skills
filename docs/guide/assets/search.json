---
layout: null
---
[
{%- assign first = true -%}
{%- for p in site.pages -%}
  {%- if p.title and p.path contains '.md' -%}
  {%- unless first -%},{%- endunless -%}
  {%- assign first = false -%}
  {"title": {{ p.title | jsonify }}, "url": {{ p.url | relative_url | jsonify }}, "text": {{ p.content | strip_html | normalize_whitespace | jsonify }}}
  {%- endif -%}
{%- endfor -%}
]
